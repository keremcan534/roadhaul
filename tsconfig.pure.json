{
  // Engine-agnostic layers are checked without DOM or Node typings, so any use of
  // window, document, console, timers, three.js etc. in them fails to compile.
  // This keeps game rules headless-testable and reusable on a future server.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.pure.tsbuildinfo",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/core", "src/data", "src/domain", "src/systems", "src/app"]
}
