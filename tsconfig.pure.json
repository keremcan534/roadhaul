{
  // Engine-agnostic layers are checked without DOM or Node typings, so using
  // window, document, console, timers, performance etc. in them fails to compile.
  // npm packages (three.js, ...) are blocked by tests/architecture/layering.test.ts.
  // Together they keep game rules headless-testable and reusable on a future server.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.pure.tsbuildinfo",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/core", "src/data", "src/domain", "src/systems", "src/app"]
}
